## Process this file with automake to produce Makefile.in
#
# Unit tests, built and run with "make check". Each test is linked against
# the convenience library ../src/libxnirspec.a (all the routines of xnirspec
# except the main program). A test passes when it exits with status 0.
#
# Run a single test:  make -C tests check TESTS=test_fpoly

check_LIBRARIES = libtestutils.a
libtestutils_a_SOURCES = test_utils.f90

check_PROGRAMS = test_fpoly test_stats test_sort test_linalg test_spline \
                 test_strings test_fitsio test_overbutton test_cutgaussfit \
                 test_writecutfits test_gauss2dfit readc_file_driver \
                 fitsio_interactive_driver subimath_driver pcutgauss_driver \
                 psavecut_driver hplot_driver

LDADD = libtestutils.a $(top_builddir)/src/libxnirspec.a

# The FITS tests need the include files (dimensions.inc is generated by
# configure) and the modules (*.mod) of src/
AM_FCFLAGS = -I$(top_builddir)/src -I$(top_srcdir)/src

test_fpoly_SOURCES = test_fpoly.f90
test_stats_SOURCES = test_stats.f90
test_sort_SOURCES = test_sort.f90
test_linalg_SOURCES = test_linalg.f90
test_spline_SOURCES = test_spline.f90
test_strings_SOURCES = test_strings.f90
test_fitsio_SOURCES = test_fitsio.f90
test_overbutton_SOURCES = test_overbutton.f90
test_cutgaussfit_SOURCES = test_cutgaussfit.f90
test_writecutfits_SOURCES = test_writecutfits.f90
test_gauss2dfit_SOURCES = test_gauss2dfit.f90
fitsio_interactive_driver_SOURCES = fitsio_interactive_driver.f90
subimath_driver_SOURCES = subimath_driver.f90
pcutgauss_driver_SOURCES = pcutgauss_driver.f90
psavecut_driver_SOURCES = psavecut_driver.f90
hplot_driver_SOURCES = hplot_driver.f90
readc_file_driver_SOURCES = readc_file_driver.f90

TESTS = test_fpoly test_stats test_sort test_linalg test_spline \
        test_strings test_fitsio test_overbutton test_cutgaussfit \
        test_writecutfits test_gauss2dfit test_readc_file.sh \
        test_fitsio_interactive.sh \
        test_subimath.sh test_pcutgauss.sh test_psavecut.sh test_hplot.sh

TEST_EXTENSIONS = .sh
SH_LOG_COMPILER = $(SHELL)

EXTRA_DIST = test_readc_file.sh test_fitsio_interactive.sh \
             test_subimath.sh test_pcutgauss.sh test_psavecut.sh \
             test_hplot.sh

# The tests use the module TEST_UTILS (test_utils.mod), which must be
# compiled first (Automake does not track Fortran module dependencies)
test_fpoly.$(OBJEXT) test_stats.$(OBJEXT) test_sort.$(OBJEXT) \
test_linalg.$(OBJEXT) test_spline.$(OBJEXT) \
test_strings.$(OBJEXT) test_fitsio.$(OBJEXT) test_overbutton.$(OBJEXT) \
test_cutgaussfit.$(OBJEXT) test_writecutfits.$(OBJEXT) \
test_gauss2dfit.$(OBJEXT) \
fitsio_interactive_driver.$(OBJEXT) subimath_driver.$(OBJEXT) \
pcutgauss_driver.$(OBJEXT) psavecut_driver.$(OBJEXT) \
hplot_driver.$(OBJEXT): libtestutils.a

# temporary FITS files left by the tests if they are interrupted
CLEANFILES = *.mod tmp_*.fits
